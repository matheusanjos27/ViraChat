# Copie para docker/.env  →  cp .env.prod.example .env

# Domínios (apontar DNS A para o IP da VPS)
APP_DOMAIN=app.seudominio.com
WA_DOMAIN=wa.seudominio.com

# URLs públicas
NEXT_PUBLIC_APP_URL=https://app.seudominio.com
EVOLUTION_SERVER_URL=https://wa.seudominio.com
EVOLUTION_API_URL=https://wa.seudominio.com
EVOLUTION_API_KEY=troque-chave-evolution-longa
EVOLUTION_WEBHOOK_SECRET=troque-secret-webhook
EVOLUTION_DB_PASSWORD=troque-senha-postgres-evolution

# Supabase — self-host na mesma VPS (ver DEPLOY-VPS.md)
# Depois do supabase/docker subir, use as URLs internas/públicas dele:
NEXT_PUBLIC_SUPABASE_URL=https://api.seudominio.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CRON_SECRET=
PLATFORM_ADMIN_EMAILS=voce@suaempresa.com
PLATFORM_ADMIN_PASSWORD=

# Migrations no deploy (GitHub Actions → deploy.sh)
# Postgres do Supabase self-host, ex.:
# DATABASE_URL=postgresql://postgres:SENHA@127.0.0.1:5432/postgres
DATABASE_URL=

# Meta (legado — não usado; removido do app por enquanto)
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
