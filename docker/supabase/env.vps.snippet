# Snippet — mescle no /opt/supabase/docker/.env após `cp .env.example .env`
# Ajuste IP/domínio da VPS KingHost / Hostinger.

############
# URLs (modo IP — sem domínio ainda)
############
# SITE_URL = URL do ViraChat (login / redirects Auth)
SITE_URL=http://SEU_IP:3000
API_EXTERNAL_URL=http://SEU_IP:8000
SUPABASE_PUBLIC_URL=http://SEU_IP:8000

############
# URLs (modo domínio + Caddy)
############
# SITE_URL=https://app.seudominio.com
# API_EXTERNAL_URL=https://api.seudominio.com
# SUPABASE_PUBLIC_URL=https://api.seudominio.com

############
# Porta Kong no host
############
KONG_HTTP_PORT=8000

############
# Depois de subir, copie ANON_KEY e SERVICE_ROLE_KEY para
# /opt/ViraChat/docker/.env e faça rebuild do virachat.
############
