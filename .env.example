# ViraChat — Environment template
# Copy to .env.local and fill with your project values.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only: 32-byte key, base64-encoded
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Evolution API / Baileys (WhatsApp por QR)
# Suba com: cd docker && docker compose up -d
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Opcional: Bearer validado em /api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=

# Cron (Vercel ou VPS): Authorization Bearer deste valor em /api/cron/*
CRON_SECRET=

# Super admin da plataforma (seed: npm run seed:platform-admin)
PLATFORM_ADMIN_EMAILS=voce@suaempresa.com
PLATFORM_ADMIN_PASSWORD=troque-esta-senha

# OpenAI — IA de atendimento
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
