# ViraChat — Environment template
# Copy to .env.local and fill with your project values.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only: 32-byte key, base64-encoded
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Meta / WhatsApp Cloud API (Fase 2)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v22.0
# Apenas em desenvolvimento local:
# META_SKIP_SIGNATURE_VERIFY=true

# Cron (Vercel): Authorization Bearer deste valor em /api/cron/*
CRON_SECRET=

# Super admin da plataforma (seed: npm run seed:platform-admin)
# Sem signup público — só este e-mail (e convites) acessam.
PLATFORM_ADMIN_EMAILS=voce@suaempresa.com
PLATFORM_ADMIN_PASSWORD=troque-esta-senha

# OpenAI — IA de atendimento
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
